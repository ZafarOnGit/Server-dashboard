# Copy this file to .env and fill in the values, or export these variables in your shell.

# Port the dashboard listens on (default: 3000)
PORT=3000

# Basic Auth credentials — change these before exposing the dashboard publicly
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# Absolute path to the directory that contains your start scripts and cfg files,
# e.g. the directory where you would normally type ./start.sh or ./start_mp.sh
SERVER_DIR=/path/to/your/game-server
